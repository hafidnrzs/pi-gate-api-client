# Gate agent on boot. Install steps: README "Running as a service".
[Unit]
Description=Industrial estate gate agent (QR scanner to barrier relay)
After=network.target
# Never stop retrying, a stopped agent means a closed barrier.
StartLimitIntervalSec=0

[Service]
# Change User and both paths to match the Pi.
User=pi
WorkingDirectory=/home/pi/Project/pi-gate-api-client
ExecStart=/usr/bin/python3 /home/pi/Project/pi-gate-api-client/gate_agent.py
# Flush every print to journald at once instead of in blocks.
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
